if __name__ == '__main__':
    if len(sys.argv) < 2:
        banner()
        print("Usage:")
        print("  python3 veles new <name>          Bootstrap a new project")
        print("  python3 veles seed <path>         Seed project memory")
        print("  python3 veles design <path> [q]   Architect design review")
        print("  python3 veles verify <path>       Pre-push quality audit")
        print("  python3 veles pipeline <path> <t> Arch->Code->Verify chain")
        print("  python3 veles run <path> <task>   Full orchestrator pipeline")
        print("  python3 veles run --bg <path> <t> Orchestrator in background")
        print("  python3 veles mcp <path>          Start MCP server")
        print("  python3 veles memory <path>       View project memory")
        print("  python3 veles status              System health check")
        print("  python3 veles tools               List all tools")
        sys.exit(0)
    
    cmd = sys.argv[1]
    
    if cmd == 'status':
        cmd_status()
    elif cmd == 'tools':
        cmd_tools()
    elif cmd == 'new' and len(sys.argv) >= 3:
        cmd_new(sys.argv[2])
    elif cmd == 'seed' and len(sys.argv) >= 3:
        cmd_seed(sys.argv[2])
    elif cmd == 'design' and len(sys.argv) >= 3:
        q = sys.argv[3] if len(sys.argv) >= 4 else None
        cmd_design(sys.argv[2], q)
    elif cmd == 'verify' and len(sys.argv) >= 3:
        cmd_verify(sys.argv[2])
    elif cmd == 'run' and len(sys.argv) >= 4:
        if sys.argv[2] == '--bg' and len(sys.argv) >= 5:
            cmd_run(sys.argv[3], ' '.join(sys.argv[4:]), background=True)
        else:
            cmd_run(sys.argv[2], ' '.join(sys.argv[3:]))
    elif cmd == 'pipeline' and len(sys.argv) >= 4:
        cmd_pipeline(sys.argv[2], ' '.join(sys.argv[3:]))
    elif cmd == 'mcp' and len(sys.argv) >= 3:
        cmd_mcp(sys.argv[2])
    elif cmd == 'memory' and len(sys.argv) >= 3:
        cmd_memory(sys.argv[2])
    else:
        print(f"Unknown command: {cmd}")
        print("Try: python3 veles (no arguments for help)")
        sys.exit(1)
